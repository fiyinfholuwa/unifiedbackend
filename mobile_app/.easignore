# Dependencies and generated bundles
node_modules
node_modules/**
**/node_modules
**/node_modules/**
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.jsbundle

# Native project folders - hidden so EAS always regenerates them
# fresh via prebuild (CNG) instead of using the locally checked-in,
# possibly stale android/ios projects.
android/
android/**
ios/
ios/**

# Local credentials and environment files
.env
.env.*
!.env.example
*.jks
*.keystore
!debug.keystore

# Source-control and local tooling metadata
.git/
.qodo/
.agents/
.codex/
.vscode/
.idea/

# Logs, tests, caches, and OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.cache/
.DS_Store
*.swp
*.swo
*.tmp
*.temp

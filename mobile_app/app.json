{
  "expo": {
    "name": "Unified Messenger",
    "slug": "unified-messenger",
    "scheme": "unified",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "backgroundColor": "#F5F1FF",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "splash": {
      "image": "./assets/unified-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F1FF"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to securely access your Unified Messenger account."
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSFaceIDUsageDescription": "Use Face ID to securely access your Unified Messenger account."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.fiyinfholuwa.unifiedmessenger"
    },
    "owner": "fiyinfholuwa",
    "extra": {
      "eas": {
        "projectId": "7551ca4d-50d7-4147-80ba-5febdc0f3906"
      }
    }
  }
}
